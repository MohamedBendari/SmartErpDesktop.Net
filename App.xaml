<Application x:Class="SmartErpDesktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
 <Color x:Key="PrimaryColor">#1A73E8</Color><SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/><SolidColorBrush x:Key="NavBrush" Color="#122038"/><SolidColorBrush x:Key="PageBrush" Color="#F5F6FA"/><SolidColorBrush x:Key="SuccessBrush" Color="#248A48"/><SolidColorBrush x:Key="DangerBrush" Color="#D93025"/>
 <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/><Setter Property="Margin" Value="3"/></Style>
</Application.Resources></Application>
