<UserControl x:Class="SmartErpDesktop.Views.QuickSaleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" CornerRadius="8" Padding="12" Margin="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="بحث بالاسم أو الكود أو الباركود"/><TextBox x:Name="ProductSearchBox" KeyDown="ProductSearch_KeyDown"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="نوع البيع"/><ComboBox x:Name="SaleTypeBox" SelectedIndex="0"><ComboBoxItem Content="كاش"/><ComboBoxItem Content="قسط أفراد"/><ComboBoxItem Content="آجل تاجر"/></ComboBox></StackPanel><Button Grid.Column="2" Content="إضافة الصنف" VerticalAlignment="Bottom" Click="AddProduct_Click"/></Grid></Border><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="سلة الفاتورة — اضغط مرتين على الكمية لتعديلها" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="CartGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" CellEditEnding="CartGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" IsReadOnly="True"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity,UpdateSourceTrigger=LostFocus}" Width="*"/><DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice,StringFormat=N2}" IsReadOnly="True"/><DataGridTextColumn Header="خصم السطر" Binding="{Binding Discount,UpdateSourceTrigger=LostFocus}" Width="*"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,StringFormat=N2}" IsReadOnly="True"/><DataGridTemplateColumn Header="إجراء"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Background="#D93025" Padding="8,3" Click="RemoveLine_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="العميل (مطلوب للقسط والآجل)"/><ComboBox x:Name="CustomerBox" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="خصم الفاتورة"/><TextBox x:Name="InvoiceDiscountBox" Text="0" TextChanged="Amounts_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="المبلغ المدفوع"/><TextBox x:Name="PaidBox" Text="0" TextChanged="Amounts_Changed"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="الصافي / المتبقي"/><TextBlock x:Name="TotalsText" Text="0.00 / 0.00 ج.م" FontSize="17" FontWeight="Bold" Foreground="#1A73E8"/></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Center"><Button Content="حفظ تجريبي" Click="Save_Click"/><Button Content="معاينة / طباعة" Background="#45556D" Click="Print_Click"/></StackPanel></Grid></Border></Grid></UserControl>