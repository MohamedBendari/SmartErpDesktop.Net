<UserControl x:Class="SmartErpDesktop.Views.QuickSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F3F6FA">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1769E0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF0F8"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- البحث ونوع البيع -->
        <Border Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,8"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="بحث بالاسم أو الكود أو الباركود"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="ProductSearchBox"
                             ToolTip="اكتب اسم المنتج أو الكود أو الباركود"
                             KeyDown="ProductSearch_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="نوع البيع" FontWeight="SemiBold"/>
                    <ComboBox x:Name="SaleTypeBox" SelectedIndex="0">
                        <ComboBoxItem Content="كاش"/>
                        <ComboBoxItem Content="قسط أفراد"/>
                        <ComboBoxItem Content="آجل تاجر"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="إضافة الصنف"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Click="AddProduct_Click"/>
            </Grid>
        </Border>

        <!-- سلة الفاتورة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,8"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="سلة الفاتورة"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="CartGrid"
                          Grid.Row="1"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          CellEditEnding="CartGrid_CellEditEnding"
                          RowHeight="36"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderBrush="#E2E8F0"
                          AlternatingRowBackground="#F8FAFC">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود"
                                            Binding="{Binding ProductCode}"
                                            IsReadOnly="True"
                                            Width="*"/>

                        <DataGridTextColumn Header="الصنف"
                                            Binding="{Binding ProductName}"
                                            IsReadOnly="True"
                                            Width="2*"/>

                        <DataGridTextColumn Header="الكمية"
                                            Binding="{Binding Quantity,UpdateSourceTrigger=LostFocus}"
                                            Width="*"/>

                        <DataGridTextColumn Header="السعر"
                                            Binding="{Binding UnitPrice,StringFormat=N2}"
                                            IsReadOnly="True"
                                            Width="*"/>

                        <DataGridTextColumn Header="خصم السطر"
                                            Binding="{Binding Discount,UpdateSourceTrigger=LostFocus}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding Total,StringFormat=N2}"
                                            IsReadOnly="True"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="إجراء" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            Padding="10,4"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="RemoveLine_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ملخص الفاتورة -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14"
                BorderBrush="#CBD5E1"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- بيانات العميل -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="العميل (مطلوب للقسط والآجل)"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="CustomerBox"
                              DisplayMemberPath="Name"/>

                    <TextBlock Text="عدد شهور التقسيط"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="InstallmentMonthsBox"
                             Text="6"/>
                </StackPanel>

                <!-- الخصم النسبي -->
                <StackPanel Grid.Column="1" Margin="4,0">
                    <TextBlock Text="خصم %"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="DiscountPercentBox"
                             Text="0"
                             TextChanged="Amounts_Changed"/>
                </StackPanel>

                <!-- الخصم الثابت -->
                <StackPanel Grid.Column="2" Margin="4,0">
                    <TextBlock Text="خصم ثابت"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="InvoiceDiscountBox"
                             Text="0"
                             TextChanged="Amounts_Changed"/>
                </StackPanel>

                <!-- المبلغ المدفوع -->
                <StackPanel Grid.Column="3" Margin="4,0">
                    <TextBlock Text="المبلغ المدفوع"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="PaidBox"
                             Text="0"
                             TextChanged="Amounts_Changed"/>
                </StackPanel>

                <!-- الإجمالي النهائي -->
                <Border Grid.Column="4"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="8,0"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="الإجمالي النهائي قبل البيع"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1E40AF"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="FinalTotalText"
                                   Text="0.00 ج.م"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#174EA6"
                                   Margin="0,2,0,5"/>

                        <TextBlock x:Name="TotalsText"
                                   Text="المتبقي: 0.00 ج.م"
                                   FontSize="12"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- أزرار الإجراءات -->
                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center"
                            MinWidth="115">

                    <Button Content="حفظ البيع"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"/>

                    <Button Content="معاينة / طباعة"
                            Style="{StaticResource SecondaryButton}"
                            Click="Print_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
