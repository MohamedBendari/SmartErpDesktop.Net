<UserControl x:Class="SmartErpDesktop.Views.CommissionRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" Padding="12" Margin="3">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="إدارة قواعد العمولات" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Foreground="#6B778C"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Width="250" ToolTip="ابحث بالمندوب أو الصنف أو الوصف" KeyDown="SearchBox_KeyDown"/>
                        <ComboBox x:Name="StatusFilter" Width="130" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="كل الحالات" IsSelected="True"/><ComboBoxItem Content="نشطة"/><ComboBoxItem Content="غير نشطة"/>
                        </ComboBox>
                        <Button Content="بحث" Click="Search_Click"/><Button Content="تحديث" Click="Refresh_Click"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#45556D"
                           Text="الأولوية: قاعدة الصنف ونوع البيع معاً، ثم قاعدة الصنف، ثم نوع البيع، ثم القاعدة العامة. داخل النطاق نفسه تُختار الأولوية الأقل رقماً؛ ترفض القواعد المتطابقة في المندوب والنطاق والأولوية. لا تُجمع القواعد. الأساس المتاح هو قيمة البند بعد خصم البند وقبل خصم الفاتورة العام. هذه الشاشة تحفظ القواعد فقط ولا تنشئ عمولات."/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="3">
            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المندوب" Binding="{Binding Representative}" Width="*"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="1.5*"/>
                    <DataGridTextColumn Header="النطاق" Binding="{Binding Scope}" Width="2*"/>
                    <DataGridTextColumn Header="النسبة %" Binding="{Binding Rate}" Width="*"/>
                    <DataGridTextColumn Header="الأساس" Binding="{Binding Basis}" Width="2*"/>
                    <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <WrapPanel Grid.Row="2" Margin="3">
            <Button Content="إضافة قاعدة" Click="Add_Click"/><Button Content="تعديل" Click="Edit_Click"/>
            <Button x:Name="ToggleButton" Content="تعطيل القاعدة" Click="Toggle_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
