<UserControl x:Class="SmartErpDesktop.Views.ModuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" Padding="12" Margin="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock x:Name="HeadingText" Text="" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubheadingText" Text="بيانات تجريبية — لا توجد قاعدة بيانات" Foreground="#6B778C"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox x:Name="FilterBox" Width="250" ToolTip="ابحث في البيانات المعروضة"/>
                    <Button Content="بحث / تصفية" Click="Filter_Click"/>
                    <Button Content="تحديث" Background="#45556D" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="3">
            <DataGrid x:Name="DataGridMain" AutoGenerateColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"/>
        </Border>
        <WrapPanel Grid.Row="2" Margin="3">
            <Button x:Name="AddTraderButton" Content="إضافة تاجر" Click="AddTrader_Click" Visibility="Collapsed"/>
            <Button x:Name="EditTraderButton" Content="تعديل تاجر" Click="EditTrader_Click" Visibility="Collapsed"/>
            <Button x:Name="DeleteTraderButton" Content="حذف / أرشفة تاجر" Click="DeleteTrader_Click" Visibility="Collapsed"/>
            <Button x:Name="PrimaryActionButton" Content="إجراء" Click="PrimaryAction_Click"/>
            <Button x:Name="SupplierStatementButton" Content="كشف حساب / سداد مورد" Click="SupplierStatement_Click" Visibility="Collapsed"/>
            <Button x:Name="SupplierListButton" Content="قائمة الموردين" Click="SupplierList_Click" Visibility="Collapsed"/>
            <Button x:Name="AddSupplierButton" Content="إضافة مورد" Click="AddSupplier_Click" Visibility="Collapsed"/>
            <Button x:Name="EditSupplierButton" Content="تعديل المورد" Click="EditSupplier_Click" Visibility="Collapsed"/>
            <Button x:Name="DeleteSupplierButton" Content="حذف / أرشفة المورد" Click="DeleteSupplier_Click" Visibility="Collapsed"/>
            <Button x:Name="SupplierInstallmentsButton" Content="جدول أقساط المورد / الفاتورة" Click="SupplierInstallments_Click" Visibility="Collapsed"/>
            <Button x:Name="AddProductButton" Content="إضافة صنف" Click="AddProduct_Click" Visibility="Collapsed"/>
            <Button x:Name="EditProductButton" Content="تعديل الصنف" Click="EditProduct_Click" Visibility="Collapsed"/>
            <Button x:Name="PriceProductButton" Content="تعديل سعر" Click="PriceProduct_Click" Visibility="Collapsed"/>
            <Button x:Name="BulkPriceButton" Content="تحديث أسعار جماعي" Click="BulkPrice_Click" Visibility="Collapsed"/>
            <Button x:Name="BarcodeButton" Content="توليد / طباعة باركود" Click="Barcode_Click" Visibility="Collapsed"/>
            <Button x:Name="StockAlertsButton" Content="تنبيهات نقص المخزون" Click="StockAlerts_Click" Visibility="Collapsed"/>
            <Button Content="تفاصيل / معاينة" Background="#45556D" Click="Details_Click"/>
            <Button x:Name="InvoiceInstallmentsButton" Content="جدول أقساط الفاتورة" Background="#0F766E" Click="InvoiceInstallments_Click" Visibility="Collapsed"/>
            <Button Content="معاينة / طباعة السجل المحدد" Background="#45556D" Click="Print_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
